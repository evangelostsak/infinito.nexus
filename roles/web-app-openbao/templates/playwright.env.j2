ADMIN_PASSWORD={{ lookup('users', 'administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}

BAO_OPERATOR_PASSWORD={{ lookup('users', 'baooperator').password | dotenv_quote }}

BAO_OPERATOR_USERNAME={{ lookup('users', 'baooperator').username | dotenv_quote }}

BAO_READER_PASSWORD={{ lookup('users', 'baoreader').password | dotenv_quote }}

BAO_READER_USERNAME={{ lookup('users', 'baoreader').username | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

# nocheck: playwright-service-gate - CSS injection is asserted by the central CSP helper, not a per-persona surface
CSS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.css.enabled') | string | lower }}

# nocheck: playwright-service-gate - OpenBao has no outbound mail surface at all (see meta/services.yml)
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

LDAP_SERVICE_ENABLED={{ OPENBAO_LDAP_ENABLED | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

# nocheck: playwright-service-gate - Matomo tracking is an injected snippet, not a per-persona surface; covered by Matomo integration tests
MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

NODE_TLS_REJECT_UNAUTHORIZED=0

OIDC_ISSUER_URL={{ OIDC.CLIENT.ISSUER_URL | dotenv_quote }}

OPENBAO_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

OPENBAO_KV_MOUNT={{ OPENBAO_KV_MOUNT | dotenv_quote }}

# nocheck: persona-block-rationale - OpenBao's UI login is not a link-then-Keycloak journey the shared persona helper can drive: the Ember auth form requires selecting the OIDC method, resolving the role through POST /v1/auth/oidc/oidc/auth_url, then completing Keycloak in a popup that posts its result back via postMessage (see upstream ui/app/components/auth-jwt.js). The administrator's full OIDC journey is asserted by the role-local files/playwright/test-oidc-login.js instead; with SSO off there is no human login path at all, since OpenBao offers no username/password auth.
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale - biber holds no OpenBao RBAC group, so by design it receives only the `default` policy and reaches no authenticated OpenBao surface; that denial is asserted by test-rbac-denial.js instead of a persona journey.
PERSONA_BIBER_BLOCKED=true

# nocheck: playwright-service-gate - scrape reachability is asserted by the web-app-prometheus spec, not this role's persona surface
PROMETHEUS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.prometheus.enabled') | string | lower }}

SSO_SERVICE_ENABLED={{ OPENBAO_SSO_ENABLED | string | lower }}
