{% set admin_networks = lookup('config', application_id, 'services.keycloak.admin.allowed_networks') | kc_admin_networks %}
{% if admin_networks %}
{% set sso_proxy_enabled = false %}
{% set http_port = lookup('config', application_id, 'services.keycloak.ports.local.http') %}
{% set proxy_service_key = 'keycloak' %}
{% set location = '^~ /admin' %}
{% set webserver_location_extra_configuration %}
{% for network in admin_networks %}
  allow {{ network }};
{% endfor %}
  deny all;
{% endset %}
{% include 'roles/sys-svc-proxy/templates/location/html.conf.j2' %}
{% endif %}
