{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}
  {% set service_name = 'openpost' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'openpost') }}
    {{ lookup('compose_only', 'container_name', OPENPOST_NAME) }}
    {{ lookup('container_ports', ['openpost', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_healthcheck', service_name) | indent(4) }}

    {{ lookup('container_depends_on', application_id) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_extra_hosts') | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}

  {% set service_name = 'relay' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'relay') }}
    {{ lookup('compose_only', 'container_name', OPENPOST_RELAY_NAME) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_extra_hosts', host_alias=True) | indent(4) }}
    {{ lookup('container_networks', aliases=OPENPOST_RELAY_DOMAINS) | indent(4) }}

  {% if OPENPOST_SIMULATOR_ENABLED | bool %}
  {% set service_name = 'simulator' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'simulator') }}
    {{ lookup('compose_only', 'container_name', OPENPOST_SIMULATOR_NAME) }}
    command:
      - --https-port
      - "{{ lookup('config', application_id, 'services.simulator.ports.internal.https') }}"
      - --https-keystore
      - "{{ lookup('volume', application_id, 'simulator_keystore').target }}"
      - --keystore-type
      - PKCS12
      - --keystore-password
      - "{{ OPENPOST_SIMULATOR_KEYSTORE_PASSWORD }}"
      - --key-manager-password
      - "{{ OPENPOST_SIMULATOR_KEYSTORE_PASSWORD }}"
      - --disable-banner
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_networks', aliases=OPENPOST_SIMULATOR_HOSTS) | indent(4) }}
  {% endif %}

{{ lookup('compose_volumes') }}

{{ lookup('compose_networks') }}
