OPENPOST_ADMIN_EMAIL={{ OPENPOST_ADMIN_EMAIL }}
OPENPOST_ADMIN_PASSWORD_B64={{ OPENPOST_ADMIN_PASSWORD | b64encode }}
OPENPOST_API_HEADERS_B64={{ OPENPOST_API_HEADERS | to_json | b64encode }}
OPENPOST_CONTAINER={{ CLI_LOCAL_CID }}
OPENPOST_DEADLINE_SECONDS={{ lookup('timeout', 600) | int }}
OPENPOST_LOCAL_URL={{ OPENPOST_LOCAL_URL }}
OPENPOST_PUBLIC_URL={{ OPENPOST_URL }}
OPENPOST_SSO_ENABLED={{ OPENPOST_OIDC_ENABLED | bool | string | lower }}
{% set _targets = {} %}
{% for _key, _role in OPENPOST_RELAY_SIBLINGS.items() if lookup('config', application_id, 'services.' ~ _key ~ '.enabled') | bool %}
{% set _ = _targets.update({_key: lookup('domain', _role)}) %}
{% endfor %}
OPENPOST_RELAY_TARGETS='{{ _targets | to_json }}'
OPENPOST_RELAY_PORT={{ lookup('config', application_id, 'services.relay.ports.internal.https') }}
