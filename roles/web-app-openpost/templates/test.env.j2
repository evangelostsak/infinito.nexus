OPENPOST_ADMIN_EMAIL={{ OPENPOST_ADMIN_EMAIL }}
OPENPOST_ADMIN_PASSWORD_B64={{ OPENPOST_ADMIN_PASSWORD | b64encode }}
OPENPOST_API_HEADERS_B64={{ OPENPOST_API_HEADERS | to_json | b64encode }}
OPENPOST_CONTAINER={{ CLI_LOCAL_CID }}
OPENPOST_DEADLINE_SECONDS={{ lookup('timeout', 600) | int }}
OPENPOST_LOCAL_URL={{ OPENPOST_LOCAL_URL }}
OPENPOST_PUBLIC_URL={{ OPENPOST_URL }}
OPENPOST_SSO_ENABLED={{ OPENPOST_OIDC_ENABLED | bool | string | lower }}
{% set _targets = {} %}
{% for _key, _role in OPENPOST_RELAY_SIBLINGS.items() if lookup('config', application_id, 'services.' ~ _key ~ '.enabled') | bool %}
{% set _ = _targets.update({_key: lookup('domain', _role)}) %}
{% endfor %}
OPENPOST_RELAY_TARGETS='{{ _targets | to_json }}'
OPENPOST_RELAY_PORT={{ lookup('config', application_id, 'services.relay.ports.internal.https') }}
{% set _platforms = [] %}
{% for _provider in (lookup('config', application_id, 'services.simulator.providers') if OPENPOST_SIMULATOR_ENABLED | bool else []) %}
{% set _ = _platforms.extend(OPENPOST_PROVIDER_APP_KEYS[_provider] if _provider in OPENPOST_PROVIDER_APP_KEYS else [_provider]) %}
{% endfor %}
OPENPOST_SIMULATOR_PLATFORMS='{{ _platforms | to_json }}'
{% set _unconfigured = [] %}
{% for _provider in ['x', 'meta', 'threads', 'linkedin', 'youtube', 'tiktok'] if _provider not in OPENPOST_PROVIDER_CREDENTIALS %}
{% set _ = _unconfigured.extend(OPENPOST_PROVIDER_APP_KEYS[_provider] if _provider in OPENPOST_PROVIDER_APP_KEYS else [_provider]) %}
{% endfor %}
OPENPOST_UNCONFIGURED_PLATFORMS='{{ _unconfigured | to_json }}'
OPENPOST_S3_PUBLIC_URL={{ lookup('objstore', application_id, 'public_url') | regex_replace('/?$', '/') if OPENPOST_OBJSTORE_ENABLED | bool else '' }}
OPENPOST_SIMULATOR_HOST={{ OPENPOST_SIMULATOR_HOSTS | first }}
OPENPOST_DB_CONTAINER={{ lookup('database', application_id, 'address') }}
OPENPOST_DB_NAME={{ lookup('database', application_id, 'name') }}
OPENPOST_DB_USER={{ lookup('database', application_id, 'username') }}
OPENPOST_DB_PASSWORD_B64={{ lookup('database', application_id, 'password') | b64encode }}
OPENPOST_PEERTUBE_USERNAME=root
OPENPOST_PEERTUBE_PASSWORD_B64={{ lookup('users', 'administrator').password | b64encode }}
OPENPOST_MEMBER_EMAIL={{ lookup('users', 'administrator').email | regex_replace('@', '+openpost-cli-member@') }}
OPENPOST_MEMBER_PASSWORD_B64={{ (lookup('users', 'administrator').password ~ ':' ~ application_id ~ ':cli-member') | hash('sha256') | b64encode }}
OPENPOST_SSO_ADMIN_EMAIL={{ OPENPOST_BOOTSTRAP_ADMINS | first if OPENPOST_OIDC_ENABLED | bool else '' }}
OPENPOST_MAIL_RECIPIENT={{ OPENPOST_BOOTSTRAP_ADMINS | first if OPENPOST_EMAIL_ENABLED | bool else '' }}
OPENPOST_MAIL_HOST={{ lookup('email', application_id).host if OPENPOST_EMAIL_ENABLED | bool else '' }}
OPENPOST_MAIL_PASSWORD_B64={{ lookup('users', 'administrator').password | b64encode }}
{% set _routes = [] %}
{% for _route in OPENPOST_CROSSPOSTER_ROUTES %}
{% set _ = _routes.append({'name': _route.name, 'platform': _route.source.platform, 'base_url': _route.source.base_url, 'account': _route.source.account, 'mode': _route.mode, 'tags': _route.filters.tags, 'social_set': _route.targets.social_set | default('', true)}) %}
{% endfor %}
OPENPOST_CROSSPOSTER_ROUTES_B64={{ _routes | to_json | b64encode }}
OPENPOST_CROSSPOSTER_POLL_SECONDS={{ OPENPOST_CROSSPOSTER.poll_interval_seconds }}
OPENPOST_CROSSPOSTER_RETRY_SECONDS={{ (OPENPOST_CROSSPOSTER.retry.max_attempts | int) * (OPENPOST_CROSSPOSTER.retry.cap_seconds | int) }}
{% if OPENPOST_CROSSPOSTER_ENABLED | bool %}
OPENPOST_CROSSPOSTER_SECRETS_FILE={{ OPENPOST_CROSSPOSTER_SECRETS_HOST }}
OPENPOST_CROSSPOSTER_CONTAINER={{ ('"$(' ~ BIN_RESOLVE_CONTAINER_ID ~ ' ' ~ (application_id | get_entity_name) ~ ' crossposter)"') if DEPLOYMENT_MODE == 'swarm' else OPENPOST_CROSSPOSTER_ADDRESS }}
OPENPOST_CROSSPOSTER_CONFIG={{ OPENPOST_CROSSPOSTER_CONFIG_TARGET }}
{% else %}
OPENPOST_CROSSPOSTER_SECRETS_FILE=
OPENPOST_CROSSPOSTER_CONTAINER=
OPENPOST_CROSSPOSTER_CONFIG=
{% endif %}
